# ============================================================
# PLANTILLA de variables de entorno - copiar a .env y completar
# Este archivo SI se sube a git (no tiene secretos reales)
# ============================================================

# --- Flask (landing_page/app.py) ---
FLASK_SECRET_KEY=generar-con-python--c-import-secrets-secrets.token_hex-32
FLASK_ENV=development
PORT=5000
N8N_WEBHOOK_URL=http://localhost:5678/webhook/leads
N8N_API_KEY=
CORS_ORIGINS=http://localhost:5000,http://localhost:8501

# --- Supabase (dashboard/dashboard.py, tests/seed_test_leads_supabase.py) ---
SUPABASE_URL=https://tu-project-id.supabase.co
SUPABASE_ANON_KEY=tu-anon-key

# Opcional: si el dashboard debe loguearse como usuario 'authenticated' en vez de 'anon'
SUPABASE_AUTH_EMAIL=
SUPABASE_AUTH_PASSWORD=

# --- n8n (configurar tambien dentro de n8n > Settings > Environment Variables,
#     estas variables las usa el WORKFLOW, no el codigo Python de este repo) ---
SUPABASE_PROJECT_ID=tu-project-id
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# --- OpenAI (credencial configurada dentro de n8n > Credentials, no la usa Python) ---
OPENAI_API_KEY=

# --- Tests (tests/test_100_leads.py, tests/seed_test_leads_supabase.py) ---
FLASK_URL=http://localhost:5000
SLEEP_ENTRE_CASOS=8
