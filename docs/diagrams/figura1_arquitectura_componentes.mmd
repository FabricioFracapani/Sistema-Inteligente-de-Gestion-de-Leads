graph TB
    subgraph USUARIO["Usuario / Prospecto"]
        U[Navegador Web]
    end

    subgraph FLASK["Landing Page - Flask :5000"]
        direction TB
        F1["Ruta / (index)"]
        F2["Ruta /api/leads (POST)"]
        F3[Validación server-side]
        F4[CSRF + Rate Limiting]
        F5[13 Security Headers]
        F6[14 Elementos SEO]
    end

    subgraph N8N["Pipeline de Automatización - n8n :5678"]
        direction TB
        N1["Webhook HTTP /leads"]
        N2["ETL: Normalización + UUID v4 + ISO 8601"]
        N3{"¿Email válido?"}
        N4["GPT-4o-mini: Clasificar intención"]
        N5{"¿Es SPAM?"}
        N6["GPT-4o-mini: Generar email HTML"]
        N7["Error Trigger (fail-loudly)"]
    end

    subgraph IA["OpenAI API"]
        O1["GPT-4o-mini<br/>classification"]
        O2["GPT-4o-mini<br/>email generation"]
    end

    subgraph DB["Supabase PostgreSQL + RLS"]
        D1[("leads<br/>(datos + IA)")]
        D2[("lead_events<br/>(append-only)")]
        D3[("ia_config<br/>(prompts)")]
        D4[("api_keys<br/>(credenciales)")]
    end

    subgraph DASHBOARD["Dashboard - Streamlit :8501"]
        S1[5 KPIs en tiempo real]
        S2[Filtros: fecha, clase, estado, prioridad]
        S3[Vista detallada con email HTML]
    end

    subgraph NOTIF["Notificaciones"]
        SL["Slack: #nuevos-leads"]
        SL2["Slack: #alertas-sistema"]
        GM["Gmail API: email al lead"]
    end

    U -->|"HTTPS POST /api/leads"| F2
    F2 --> F3
    F3 --> F4
    F1 --> F6
    F2 --> F5

    F3 -->|"JSON + API Key"| N1
    N1 -->|"fast ack HTTP 200"| F2
    N1 --> N2
    N2 --> N3
    N3 -->|"Sí"| N4
    N3 -->|"No"| N7
    N4 --> O1
    O1 -->|"JSON: clase, prioridad, resumen"| N4
    N4 --> N5
    N5 -->|"No spam"| N6
    N5 -->|"Spam"| D1
    N6 --> O2
    O2 -->|"JSON: asunto, HTML"| N6

    N6 --> D1
    D1 --> GM
    D1 --> SL

    D1 --> D2
    D1 --> D3
    D1 --> D4

    D1 -->|"SELECT via RLS"| S1
    S1 --> S2
    S2 --> S3

    N7 --> SL2
